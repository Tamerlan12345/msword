generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("APPROVER") // ADMIN, APPROVER

  createdAt DateTime @default(now())

  // Relations
  documents Document[] @relation("CreatedDocument")
  lastEditedDocuments Document[] @relation("LastEditedDocument")
  approvals DocumentApprover[]
  comments  Comment[]
  wopiTokens WopiToken[]
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String?  @default("")
  status    String   @default("DRAFT") // DRAFT, ON_APPROVAL, APPROVED, REJECTED

  googleFileId String? // Added for Google Docs integration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], name: "CreatedDocument")

  lastEditorId String?
  lastEditor   User?   @relation(fields: [lastEditorId], references: [id], name: "LastEditedDocument")

  versions  DocumentVersion[]
  approvers DocumentApprover[]
  comments  Comment[]
  wopiTokens WopiToken[]
  wopiLock   WopiLock?
}

model WopiToken {
  token      String   @id @default(uuid())
  userId     String
  documentId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  document   Document @relation(fields: [documentId], references: [id])
}

model WopiLock {
  id         String   @id @default(uuid())
  documentId String   @unique
  lockId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id])
}

model DocumentApprover {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  comment    String?

  assignedAt DateTime @default(now())

  @@unique([documentId, userId])
}

model Comment {
  id         String   @id @default(uuid())
  content    String

  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model DocumentVersion {
  id         String   @id @default(uuid())
  version    Int
  filePath   String
  createdAt  DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
}
